@model PracticalNCode.Application.Models.CreateEmployeeLoginViewModel
@{
    ViewData["Title"] = "Create Employee Login";
    var employeeList = ViewBag.EmployeeList as SelectList;
    var isPreselected = !string.IsNullOrWhiteSpace(Model.EmployeeName);
}

<div class="row justify-content-center">
    <div class="col-md-7 col-lg-6">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-primary text-white py-3">
                <h4 class="mb-0 fw-bold">Create Employee Login Account</h4>
                <small class="text-white-50">Links new login credentials to an existing employee record.</small>
            </div>
            <div class="card-body p-4">
                <form asp-action="CreateEmployeeLogin" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                    <h5 class="fw-bold text-secondary border-bottom pb-2 mb-3">Employee Record</h5>

                    @if (isPreselected)
                    {
                        <input type="hidden" asp-for="EmployeeId" />
                        <div class="alert alert-light border mb-3">
                            <div class="row g-2">
                                <div class="col-6">
                                    <span class="text-muted small d-block">Employee Name</span>
                                    <strong>@Model.EmployeeName</strong>
                                </div>
                                <div class="col-6">
                                    <span class="text-muted small d-block">Employee ID</span>
                                    <strong>@Model.EmployeeCode</strong>
                                </div>
                                <div class="col-6">
                                    <span class="text-muted small d-block">Organization</span>
                                    <span>@Model.OrganizationName</span>
                                </div>
                                <div class="col-6">
                                    <span class="text-muted small d-block">Email</span>
                                    <span>@Model.EmployeeEmail</span>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="mb-3">
                            <label asp-for="EmployeeId" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                            <select asp-for="EmployeeId" asp-items="employeeList" class="form-select">
                                <option value="">-- Select an Employee --</option>
                            </select>
                            <span asp-validation-for="EmployeeId" class="text-danger small"></span>
                        </div>
                    }

                    <h5 class="fw-bold text-secondary border-bottom pb-2 mb-3">Login Credentials</h5>

                    <div class="mb-3">
                        <label asp-for="Username" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                        <input asp-for="Username" class="form-control" placeholder="Choose a unique username" />
                        <span asp-validation-for="Username" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                        <input asp-for="Password" class="form-control" placeholder="Min. 6 chars (e.g. Emp@123)" />
                        <div class="form-text small">At least 1 digit and 1 special character.</div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                        <input asp-for="ConfirmPassword" class="form-control" placeholder="Repeat password" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between pt-2">
                        <a asp-action="EmployeeLogins" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4 fw-semibold">Create &amp; Link Account</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

