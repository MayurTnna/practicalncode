@model IReadOnlyList<PracticalNCode.Application.Models.EmployeeItemViewModel>
@{
    ViewData["Title"] = "Organization - Employees";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-0">Employee Management</h2>
        <p class="text-muted mb-0">Manage employee records for your organization</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-primary">
            + Add Employee
        </a>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-header bg-white py-3">
        <h5 class="mb-0 fw-bold">Employees List</h5>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Employee ID</th>
                        <th>Name</th>
                        <th>Email Address</th>
                        <th>Mobile Number</th>
                        <th>Department</th>
                        <th>Designation</th>
                        <th>Login Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model == null || !Model.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-4 text-muted">
                                No employees found. Click "+ Add Employee" above to create an employee record.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var emp in Model)
                        {
                            <tr>
                                <td class="fw-semibold">@emp.EmployeeCode</td>
                                <td>@emp.FullName</td>
                                <td>@emp.Email</td>
                                <td>@emp.MobileNumber</td>
                                <td>@emp.Department</td>
                                <td>@emp.Designation</td>
                                <td>
                                    @if (emp.HasLoginAccount)
                                    {
                                        <span class="badge bg-success">Active Login</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">No Login Yet</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <a asp-action="Edit" asp-route-id="@emp.EmployeeId" class="btn btn-sm btn-outline-primary me-1">
                                        Edit
                                    </a>
                                    <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteModal-@emp.EmployeeId">
                                        Delete
                                    </button>

                                    <!-- Delete Confirmation Modal -->
                                    <div class="modal fade" id="deleteModal-@emp.EmployeeId" tabindex="-1" aria-labelledby="deleteModalLabel-@emp.EmployeeId" aria-hidden="true">
                                        <div class="modal-dialog modal-dialog-centered">
                                            <div class="modal-content text-start">
                                                <div class="modal-header bg-danger text-white">
                                                    <h5 class="modal-title" id="deleteModalLabel-@emp.EmployeeId">Confirm Delete</h5>
                                                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                                </div>
                                                <div class="modal-body">
                                                    <p class="mb-2">Are you sure you want to delete employee <strong>@emp.FullName</strong> (ID: <strong>@emp.EmployeeCode</strong>)?</p>
                                                    <div class="alert alert-warning mb-0 small">
                                                        <strong>Warning:</strong> Deleting this employee will immediately deactivate their login account and revoke access to the application.
                                                    </div>
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                    <form asp-action="Delete" asp-route-id="@emp.EmployeeId" method="post" class="d-inline">
                                                        <button type="submit" class="btn btn-danger">Confirm Delete</button>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

