@{
    ViewData["Title"] = "Access Denied";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6 text-center">
        <div class="card shadow-sm border-0 p-5">
            <h1 class="display-4 text-danger fw-bold">403</h1>
            <h3 class="mb-3">Access Denied</h3>
            <p class="text-muted mb-4">You do not have permission to access this resource or page.</p>
            <div>
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Return to Home</a>
            </div>
        </div>
    </div>
</div>

