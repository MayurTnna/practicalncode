@model IReadOnlyList<PracticalNCode.Application.Models.OrganizationItemViewModel>
@{
    ViewData["Title"] = "Admin Dashboard";
    var users = ViewBag.Users as IReadOnlyList<PracticalNCode.Application.Models.UserItemViewModel> ?? [];
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-0">Admin Dashboard</h2>
        <p class="text-muted mb-0">Manage Organizations and User Login Credentials</p>
    </div>
    <div>
        <a asp-action="CreateOrganization" class="btn btn-primary me-2">
            + Create Organization
        </a>
        <a asp-action="EmployeeLogins" class="btn btn-outline-primary">
            Manage Employee Logins
        </a>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card shadow-sm border-0 bg-primary text-white">
            <div class="card-body">
                <h6 class="text-uppercase text-white-50">Organizations</h6>
                <h2 class="fw-bold mb-0">@ViewBag.TotalOrganizations</h2>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm border-0 bg-success text-white">
            <div class="card-body">
                <h6 class="text-uppercase text-white-50">Active Employees</h6>
                <h2 class="fw-bold mb-0">@ViewBag.TotalEmployees</h2>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm border-0 bg-dark text-white">
            <div class="card-body">
                <h6 class="text-uppercase text-white-50">Login Accounts</h6>
                <h2 class="fw-bold mb-0">@ViewBag.TotalUsers</h2>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h5 class="mb-0 fw-bold">Organizations</h5>
        <a asp-action="CreateOrganization" class="btn btn-sm btn-primary">+ Add New Organization</a>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>ID</th>
                        <th>Organization Name</th>
                        <th>Contact Email</th>
                        <th>Contact Phone</th>
                        <th>Status</th>
                        <th>Created At</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model == null || !Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">
                                No organizations created yet. Click "+ Create Organization" above to add one.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var org in Model)
                        {
                            <tr>
                                <td>@org.OrganizationId</td>
                                <td class="fw-semibold">@org.OrganizationName</td>
                                <td>@(string.IsNullOrWhiteSpace(org.ContactEmail) ? "-" : org.ContactEmail)</td>
                                <td>@(string.IsNullOrWhiteSpace(org.ContactPhone) ? "-" : org.ContactPhone)</td>
                                <td>
                                    @if (org.IsActive)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Inactive</span>
                                    }
                                </td>
                                <td>@org.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h5 class="mb-0 fw-bold">User Login Accounts</h5>
        <a asp-action="EmployeeLogins" class="btn btn-sm btn-outline-primary">Manage Employee Logins</a>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>User ID</th>
                        <th>Username</th>
                        <th>Role</th>
                        <th>Organization</th>
                        <th>Linked Employee</th>
                        <th>Status</th>
                        <th>Created At</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!users.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">No user accounts found.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var u in users)
                        {
                            <tr>
                                <td>@u.UserId</td>
                                <td class="fw-semibold">@u.Username</td>
                                <td>
                                    @if (u.RoleName == "Admin")
                                    {
                                        <span class="badge bg-danger">Admin</span>
                                    }
                                    else if (u.RoleName == "Organization")
                                    {
                                        <span class="badge bg-primary">Organization</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-info text-dark">Employee</span>
                                    }
                                </td>
                                <td>@(string.IsNullOrWhiteSpace(u.OrganizationName) ? "-" : u.OrganizationName)</td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(u.EmployeeName))
                                    {
                                        <span>@u.EmployeeName (@u.EmployeeCode)</span>
                                    }
                                    else
                                    {
                                        <span>-</span>
                                    }
                                </td>
                                <td>
                                    @if (u.IsActive)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Deactivated</span>
                                    }
                                </td>
                                <td>@u.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

