@model PracticalNCode.Application.Models.EditEmployeeViewModel
@{
    ViewData["Title"] = "Edit Employee";
}

<div class="row justify-content-center">
    <div class="col-md-7 col-lg-6">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-primary text-white py-3">
                <h4 class="mb-0 fw-bold">Edit Employee</h4>
                <small class="text-white-50">Update employee details for your organization.</small>
            </div>
            <div class="card-body p-4">
                <form asp-action="Edit" asp-route-id="@Model.EmployeeId" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                    <input type="hidden" asp-for="EmployeeId" />
                    <input type="hidden" asp-for="OrganizationId" />

                    <div class="mb-3">
                        <label asp-for="EmployeeCode" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                        <input asp-for="EmployeeCode" class="form-control" />
                        <span asp-validation-for="EmployeeCode" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                        <input asp-for="FullName" class="form-control" />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                            <input asp-for="Email" class="form-control" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="MobileNumber" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                            <input asp-for="MobileNumber" class="form-control" placeholder="10-digit number (e.g. 9876543210)" maxlength="10" />
                            <span asp-validation-for="MobileNumber" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="Department" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                            <input asp-for="Department" class="form-control" />
                            <span asp-validation-for="Department" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Designation" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                            <input asp-for="Designation" class="form-control" />
                            <span asp-validation-for="Designation" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between pt-2">
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4 fw-semibold">Save Changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

