@model PracticalNCode.Application.Models.CreateOrganizationViewModel
@{
    ViewData["Title"] = "Create Organization";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-7">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-primary text-white py-3">
                <h4 class="mb-0 fw-bold">Create Organization &amp; Login Account</h4>
                <small class="text-white-50">Registers the organization and sets up its initial login credentials.</small>
            </div>
            <div class="card-body p-4">
                <form asp-action="CreateOrganization" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                    <h5 class="fw-bold text-secondary border-bottom pb-2 mb-3">Organization Information</h5>
                    <div class="mb-3">
                        <label asp-for="OrganizationName" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                        <input asp-for="OrganizationName" class="form-control" placeholder="e.g. Acme Corporation" />
                        <span asp-validation-for="OrganizationName" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="ContactEmail" class="form-label fw-semibold"></label>
                            <input asp-for="ContactEmail" class="form-control" placeholder="contact@organization.com" />
                            <span asp-validation-for="ContactEmail" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ContactPhone" class="form-label fw-semibold"></label>
                            <input asp-for="ContactPhone" class="form-control" placeholder="Enter 10-digit mobile number" />
                            <span asp-validation-for="ContactPhone" class="text-danger small"></span>
                        </div>
                    </div>

                    <h5 class="fw-bold text-secondary border-bottom pb-2 mb-3">Login Account Credentials</h5>
                    <div class="mb-3">
                        <label asp-for="Username" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                        <input asp-for="Username" class="form-control" placeholder="Unique username for organization login" />
                        <span asp-validation-for="Username" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="Password" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                            <input asp-for="Password" class="form-control" placeholder="Min. 6 chars (e.g. Org@123)" />
                            <div class="form-text small">At least 1 digit and 1 special character.</div>
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ConfirmPassword" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                            <input asp-for="ConfirmPassword" class="form-control" placeholder="Repeat password" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between pt-2">
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4 fw-semibold">Create Organization &amp; Login</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

